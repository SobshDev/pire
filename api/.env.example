# Replace with a strong local password. Never leave a production password at this value.
DATABASE_URL=postgres://pire:replace-me-with-a-long-random-password@localhost:5433/pire
BIND_ADDR=127.0.0.1:8080
# Set to the built frontend (../web/dist) to serve it from the API.
STATIC_DIR=
# Must be true behind HTTPS in production.
COOKIE_SECURE=false

# The AI tutor. Leave TUTOR_API_KEY empty to turn it off.
# TUTOR_BASE_URL is an Anthropic Messages API without the /v1/messages path, such as shared_router.
TUTOR_BASE_URL=http://127.0.0.1:8081
TUTOR_API_KEY=
TUTOR_MODEL=claude-sonnet-4-6
TUTOR_MAX_TOKENS=800
